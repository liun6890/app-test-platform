# Fastbot core configuration

# Model output prefix on the attached Android device.
model.save_path = /sdcard/fastbot_

# Reuse an existing model between cycles.
model.reuse = true

# Maximum model traversal depth.
max.depth = 100

# Internal action timeout in milliseconds.
timeout = 10000

# Keep the run inside the configured package and avoid rotation APIs removed
# from newer Android releases.
max.doRotateFuzzing = 0
max.doAppSwitchFuzzing = 0
max.doNavKeyFuzzing = 0
max.doSystemKeyFuzzing = 0
max.doKeyCodeFuzzing = 0
# Forward model-generated BACK events as part of normal Fastbot input.
max.blockBackFuzzing = false
max.doTrackballFuzzing = 0
max.doDragFuzzing = 1
max.doPinchZoomFuzzing = 1
max.fuzzingRate = 0
max.doHoming = false
max.doHistoryRestart = false
max.doMutationAirplaneFuzzing = 0
max.doMutationWifiFuzzing = 0
max.doMutationMutationAlwaysFinishActivitysFuzzing = 0
max.startMutation = 0

# Optional activity filters. Keep empty to exercise the whole target package.
blacklist.activity =
whitelist.activity =
